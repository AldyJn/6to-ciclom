@model Libro

<tr>
    <td>@Model.Titulo</td>
    <td>@Model.ISBN</td>
    <td>@Model.AutorNombre</td>
    <td>@Model.Ejemplares</td>
    <td class="text-end">
        <a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@Model.LibroId">Detalle</a>
        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@Model.LibroId">Editar</a>
        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@Model.LibroId">Eliminar</a>
    </td>
</tr>
