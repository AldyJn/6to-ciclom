@model IEnumerable<Libro>
@{
    ViewData["Title"] = "Libros";
    var busqueda = ViewData["Busqueda"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Libros</h1>
    <a class="btn btn-success" asp-action="Create">Nuevo libro</a>
</div>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input type="text" name="titulo" value="@busqueda" class="form-control" placeholder="Buscar por título" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Título</th>
            <th>ISBN</th>
            <th>Autor</th>
            <th>Ejemplares</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var libro in Model)
        {
            <partial name="_LibroFila" model="libro" />
        }
        @if (!Model.Any())
        {
            <tr><td colspan="5" class="text-center text-muted">No se encontraron libros.</td></tr>
        }
    </tbody>
</table>
