@model Libro
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Editar libro";
}

<h1 class="h3 mb-3">Editar libro</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.LibroId" method="post">
            <partial name="_FormularioLibro" model="Model" />
            <button type="submit" class="btn btn-primary">Actualizar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
