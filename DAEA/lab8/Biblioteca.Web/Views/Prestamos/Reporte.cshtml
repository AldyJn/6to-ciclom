@model IEnumerable<PrestamoReporte>
@{
    ViewData["Title"] = "Reporte de préstamos";
}

<h1 class="h3 mb-3">Reporte de préstamos</h1>

<form method="get" asp-action="Reporte" class="row g-2 align-items-end mb-3">
    <div class="col-sm-4 col-md-3">
        <label for="desde" class="form-label">Desde</label>
        <input type="date" id="desde" name="desde" value="@ViewData["Desde"]" class="form-control" />
    </div>
    <div class="col-sm-4 col-md-3">
        <label for="hasta" class="form-label">Hasta</label>
        <input type="date" id="hasta" name="hasta" value="@ViewData["Hasta"]" class="form-control" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Consultar</button>
    </div>
</form>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>N.° préstamo</th>
            <th>Socio</th>
            <th>Libro</th>
            <th>Fecha de préstamo</th>
            <th>Fecha límite</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var fila in Model)
        {
            <tr>
                <td>@fila.PrestamoId</td>
                <td>@fila.Socio</td>
                <td>@fila.Libro</td>
                <td>@fila.FechaPrestamo.ToString("dd/MM/yyyy")</td>
                <td>@fila.FechaLimite.ToString("dd/MM/yyyy")</td>
                <td>
                    <span class="badge @(fila.Estado == "Pendiente" ? "text-bg-warning" : "text-bg-success")">@fila.Estado</span>
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="6" class="text-center text-muted">No hay préstamos en el rango seleccionado.</td></tr>
        }
    </tbody>
</table>
