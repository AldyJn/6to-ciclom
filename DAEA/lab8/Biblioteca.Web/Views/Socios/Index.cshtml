@model IEnumerable<Socio>
@{
    ViewData["Title"] = "Socios";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Socios</h1>
    <a class="btn btn-success" asp-action="Create">Nuevo socio</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombre</th>
            <th>Correo</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var socio in Model)
        {
            <tr>
                <td>@socio.DNI</td>
                <td>@socio.Nombre</td>
                <td>@socio.Email</td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr><td colspan="3" class="text-center text-muted">No hay socios registrados.</td></tr>
        }
    </tbody>
</table>
