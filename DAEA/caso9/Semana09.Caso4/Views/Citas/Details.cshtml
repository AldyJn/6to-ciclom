@model Cita
@{ ViewData["Title"] = "Detalle de cita"; }

<h1>Cita #@Model.Id</h1>
<dl class="row">
    <dt class="col-sm-2">Paciente</dt><dd class="col-sm-10">@Model.Paciente</dd>
    <dt class="col-sm-2">Correo</dt><dd class="col-sm-10">@Model.Correo</dd>
    <dt class="col-sm-2">Especialidad</dt><dd class="col-sm-10">@Model.Especialidad</dd>
    <dt class="col-sm-2">Fecha</dt><dd class="col-sm-10">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
    <dt class="col-sm-2">Primera vez</dt><dd class="col-sm-10">@(Model.PrimeraVez ? "Sí" : "No")</dd>
</dl>
<a asp-action="Index">Volver</a>
