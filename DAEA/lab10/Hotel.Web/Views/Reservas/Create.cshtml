@model Reserva
@{
    ViewData["Title"] = "Nueva reserva";
}

<div class="mb-4">
    <h1 class="titulo">Nueva reserva</h1>
    <p class="subtitulo">La reserva se registra con estado Pendiente</p>
</div>

<form asp-action="Create" method="post" class="panel" style="max-width: 640px">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="IdHuesped" class="form-label">Huésped</label>
        <select asp-for="IdHuesped" class="form-select" asp-items="(List<SelectListItem>)ViewBag.Huespedes">
            <option value="">Seleccione un huésped</option>
        </select>
        <span asp-validation-for="IdHuesped" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="IdHabitacion" class="form-label">Habitación</label>
        <select asp-for="IdHabitacion" class="form-select" asp-items="(List<SelectListItem>)ViewBag.Habitaciones">
            <option value="">Seleccione una habitación</option>
        </select>
        <span asp-validation-for="IdHabitacion" class="text-danger small"></span>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-sm-6">
            <label asp-for="FechaIngreso" class="form-label">Fecha de ingreso</label>
            <input asp-for="FechaIngreso" class="form-control" />
            <span asp-validation-for="FechaIngreso" class="text-danger small"></span>
        </div>
        <div class="col-sm-6">
            <label asp-for="FechaSalida" class="form-label">Fecha de salida</label>
            <input asp-for="FechaSalida" class="form-control" />
            <span asp-validation-for="FechaSalida" class="text-danger small"></span>
        </div>
    </div>

    <div class="mb-4">
        <label asp-for="Observaciones" class="form-label">Observaciones</label>
        <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="200"></textarea>
        <span asp-validation-for="Observaciones" class="text-danger small"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-acento">Registrar reserva</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>
