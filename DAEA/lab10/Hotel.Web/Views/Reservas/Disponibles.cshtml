@model DisponiblesViewModel
@{
    ViewData["Title"] = "Disponibilidad";
    var ingresoTxt = Model.Ingreso?.ToString("yyyy-MM-dd");
    var salidaTxt = Model.Salida?.ToString("yyyy-MM-dd");
}

<div class="mb-4">
    <h1 class="titulo">Disponibilidad</h1>
    <p class="subtitulo">Consulta las habitaciones libres para un rango de fechas</p>
</div>

<form method="get" class="panel mb-3">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <div class="row g-3 align-items-end">
        <div class="col-sm-6 col-md-3">
            <label class="form-label" for="ingreso">Fecha de ingreso</label>
            <input type="date" id="ingreso" name="ingreso" class="form-control" value="@ingresoTxt" required />
        </div>
        <div class="col-sm-6 col-md-3">
            <label class="form-label" for="salida">Fecha de salida</label>
            <input type="date" id="salida" name="salida" class="form-control" value="@salidaTxt" required />
            <span asp-validation-for="Salida" class="text-danger small"></span>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-dark"><i class="bi bi-search"></i> Buscar</button>
        </div>
    </div>
</form>

@if (Model.Buscado && ViewData.ModelState.IsValid)
{
    <div class="tabla">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Habitación</th>
                    <th>Piso</th>
                    <th>Tipo</th>
                    <th>Capacidad</th>
                    <th class="text-end">Precio por noche</th>
                    <th class="text-end">Noches</th>
                    <th class="text-end">Total estimado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td class="fw-semibold">@item.Numero</td>
                        <td>@item.Piso</td>
                        <td>@item.Tipo</td>
                        <td>@item.Capacidad</td>
                        <td class="text-end">S/ @item.PrecioNoche.ToString("N2")</td>
                        <td class="text-end">@item.Noches</td>
                        <td class="text-end fw-semibold">S/ @item.Total.ToString("N2")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-action="Create"
                               asp-route-idHabitacion="@item.IdHabitacion"
                               asp-route-ingreso="@ingresoTxt"
                               asp-route-salida="@salidaTxt">Reservar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (!Model.Items.Any())
        {
            <div class="vacio">No hay habitaciones libres para esas fechas.</div>
        }
    </div>
}
