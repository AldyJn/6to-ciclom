<UserControl x:Class="lab4.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="Código" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtId" IsReadOnly="True" Background="#EEE"/>
                <TextBlock Text="Compañía" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtCompania" MaxLength="60"/>
                <TextBlock Text="Nombre de contacto" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtContacto" MaxLength="40"/>
                <TextBlock Text="Cargo del contacto" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtCargo" MaxLength="40"/>
                <TextBlock Text="Dirección" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtDireccion" MaxLength="80"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Ciudad" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="txtCiudad" MaxLength="30"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Código postal" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="txtPostal" MaxLength="10"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="País" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtPais" MaxLength="30"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Teléfono" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="txtTelefono" MaxLength="24"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Fax" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="txtFax" MaxLength="24"/>
                    </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Nuevo" Click="Nuevo_Click"/>
                    <Button Content="Guardar" Click="Guardar_Click"/>
                    <Button Content="Eliminar" Click="Eliminar_Click" Background="#B3261E"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#CCD6E0" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Buscar por nombre de contacto" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="txtBuscarContacto" Width="210" Margin="0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Buscar por ciudad" Style="{StaticResource Etiqueta}"/>
                        <TextBox x:Name="txtBuscarCiudad" Width="170" Margin="0"/>
                    </StackPanel>
                    <Button Content="Buscar" Click="Buscar_Click" VerticalAlignment="Bottom"/>
                    <Button Content="Ver todos" Click="Todos_Click" VerticalAlignment="Bottom" Background="#5F6B7A"/>
                </StackPanel>
            </Border>
            <DataGrid x:Name="grid" Grid.Row="1" SelectionChanged="Grid_SelectionChanged"
                      AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
        </Grid>
    </Grid>
</UserControl>
