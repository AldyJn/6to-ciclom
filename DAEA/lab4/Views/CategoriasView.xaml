<UserControl x:Class="lab4.Views.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,16,0">
            <TextBlock Text="Código" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtId" IsReadOnly="True" Background="#EEE"/>
            <TextBlock Text="Nombre de categoría" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtNombre" MaxLength="30"/>
            <TextBlock Text="Descripción" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtDescripcion" MaxLength="200" Height="90" TextWrapping="Wrap" AcceptsReturn="True"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Nuevo" Click="Nuevo_Click"/>
                <Button Content="Guardar" Click="Guardar_Click"/>
                <Button Content="Eliminar" Click="Eliminar_Click" Background="#B3261E"/>
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="grid" Grid.Column="1" SelectionChanged="Grid_SelectionChanged"
                  AutoGeneratingColumn="Grid_AutoGeneratingColumn"/>
    </Grid>
</UserControl>
