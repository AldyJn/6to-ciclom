<Window x:Class="lab6.Views.PrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NeptunoDB - Mantenimientos" Height="760" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Linea}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,4">
                    <TextBlock Text="NeptunoDB" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="WPF + ADO .NET" Foreground="{StaticResource Suave}"
                               FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="MANTENIMIENTOS" Style="{StaticResource Seccion}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True"
                                 Content="Productos" Command="{Binding ProductosCommand}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Categorias" Command="{Binding CategoriasCommand}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Proveedores" Command="{Binding ProveedoresCommand}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Pedidos" Command="{Binding PedidosCommand}"/>

                    <TextBlock Text="REPORTES" Style="{StaticResource Seccion}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Content="Detalle por fechas" Command="{Binding ReporteCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding Vista}" Margin="30,24"/>
    </Grid>
</Window>
