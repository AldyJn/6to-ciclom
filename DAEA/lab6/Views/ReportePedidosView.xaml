<UserControl x:Class="lab6.Views.ReportePedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Detalle de Pedidos por Intervalo de Fechas"
                   Style="{StaticResource Titulo}"/>

        <!-- Punto 12.a: filtros de fecha del reporte -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Desde" Foreground="{StaticResource Suave}" Margin="0,0,8,0"/>
            <DatePicker Style="{StaticResource FiltroFecha}" SelectedDate="{Binding Desde}"/>

            <TextBlock Text="Hasta" Foreground="{StaticResource Suave}" Margin="0,0,8,0"/>
            <DatePicker Style="{StaticResource FiltroFecha}" SelectedDate="{Binding Hasta}"/>

            <Button Content="Generar reporte" Command="{Binding GenerarCommand}"/>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Detalles}" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pedido" Binding="{Binding PedidoID}" Width="60"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat=dd/MM/yyyy}" Width="90"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="190"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="130"/>
                <DataGridTextColumn Header="Ciudad" Binding="{Binding CiudadDestino}" Width="90"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat=N2}" Width="75"/>
                <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="55"/>
                <DataGridTextColumn Header="Dcto." Binding="{Binding Descuento, StringFormat=P0}" Width="55"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N2}" Width="85"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Mensaje}" Style="{StaticResource Mensaje}"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Total" Foreground="{StaticResource Suave}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding Total, StringFormat=N2}" FontWeight="SemiBold" FontSize="15"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
