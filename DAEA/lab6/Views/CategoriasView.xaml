<UserControl x:Class="lab6.Views.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Mantenimiento de Categorias"
                   Style="{StaticResource Titulo}"/>

        <DataGrid Grid.Row="1" Grid.Column="0" Margin="0,0,24,0"
                  ItemsSource="{Binding Categorias}"
                  SelectedItem="{Binding Seleccionada}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding CategoriaID}" Width="60"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding NombreCategoria}" Width="200"/>
                <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="*"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Formulario}">
            <StackPanel>
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource Subtitulo}"/>

                <TextBlock Text="NOMBRE" Style="{StaticResource Etiqueta}"/>
                <TextBox Text="{Binding Editada.NombreCategoria, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="DESCRIPCION" Style="{StaticResource Etiqueta}"/>
                <TextBox Text="{Binding Editada.Descripcion}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="90"
                         VerticalScrollBarVisibility="Auto"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Guardar" Command="{Binding GuardarCommand}" Margin="0,0,8,0"/>
                    <Button Content="Nuevo" Command="{Binding NuevoCommand}"
                            Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"/>
                    <Button Content="Eliminar" Command="{Binding EliminarCommand}"
                            Style="{StaticResource BotonPeligro}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Mensaje}"
                   Style="{StaticResource Mensaje}" Margin="0,16,0,0"/>
    </Grid>
</UserControl>
