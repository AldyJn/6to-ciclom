<UserControl x:Class="lab6.Views.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Mantenimiento de Proveedores"
                   Style="{StaticResource Titulo}"/>

        <!-- Punto 11.a: filtros de busqueda por nombre de contacto y ciudad -->
        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,24,16">
            <TextBlock Text="Contacto" Foreground="{StaticResource Suave}" Margin="0,0,8,0"/>
            <TextBox Style="{StaticResource FiltroCaja}"
                     Text="{Binding FiltroContacto, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Ciudad" Foreground="{StaticResource Suave}" Margin="0,0,8,0"/>
            <TextBox Style="{StaticResource FiltroCaja}"
                     Text="{Binding FiltroCiudad, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Buscar" Command="{Binding BuscarCommand}" Margin="0,0,8,0"/>
            <Button Content="Limpiar" Command="{Binding LimpiarCommand}"
                    Style="{StaticResource BotonSecundario}"/>
        </StackPanel>

        <DataGrid Grid.Row="2" Grid.Column="0" Margin="0,0,24,0"
                  ItemsSource="{Binding Proveedores}"
                  SelectedItem="{Binding Seleccionado}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ProveedorID}" Width="50"/>
                <DataGridTextColumn Header="Compania" Binding="{Binding CompaniaNombre}" Width="*" MinWidth="170"/>
                <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="140"/>
                <DataGridTextColumn Header="Cargo" Binding="{Binding CargoContacto}" Width="155"/>
                <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="95"/>
                <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="105"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Formulario}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource Subtitulo}"/>

                    <TextBlock Text="COMPANIA" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Editado.CompaniaNombre, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="NOMBRE DE CONTACTO" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Editado.NombreContacto}"/>

                    <TextBlock Text="CARGO DE CONTACTO" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Editado.CargoContacto}"/>

                    <TextBlock Text="DIRECCION" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Editado.Direccion}"/>

                    <TextBlock Text="CIUDAD" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Editado.Ciudad}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="CODIGO POSTAL" Style="{StaticResource Etiqueta}"/>
                            <TextBox Text="{Binding Editado.CodigoPostal}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PAIS" Style="{StaticResource Etiqueta}"/>
                            <TextBox Text="{Binding Editado.Pais}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="TELEFONO" Style="{StaticResource Etiqueta}"/>
                            <TextBox Text="{Binding Editado.Telefono}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="FAX" Style="{StaticResource Etiqueta}"/>
                            <TextBox Text="{Binding Editado.Fax}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" Margin="0,0,8,0"/>
                        <Button Content="Nuevo" Command="{Binding NuevoCommand}"
                                Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"/>
                        <Button Content="Eliminar" Command="{Binding EliminarCommand}"
                                Style="{StaticResource BotonPeligro}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Mensaje}"
                   Style="{StaticResource Mensaje}" Margin="0,16,0,0"/>
    </Grid>
</UserControl>
