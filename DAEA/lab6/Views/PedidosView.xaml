<UserControl x:Class="lab6.Views.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Mantenimiento de Pedidos"
                   Style="{StaticResource Titulo}"/>

        <DataGrid Grid.Row="1" Grid.Column="0" Margin="0,0,24,0"
                  ItemsSource="{Binding Pedidos}"
                  SelectedItem="{Binding Seleccionado}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding PedidoID}" Width="50"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*" MinWidth="170"/>
                <DataGridTextColumn Header="Empleado" Binding="{Binding Empleado}" Width="140"/>
                <DataGridTextColumn Header="Pedido" Binding="{Binding FechaPedido, StringFormat=dd/MM/yyyy}" Width="85"/>
                <DataGridTextColumn Header="Requerida" Binding="{Binding FechaRequerida, StringFormat=dd/MM/yyyy}" Width="85"/>
                <DataGridTextColumn Header="Envio" Binding="{Binding FechaEnvio, StringFormat=dd/MM/yyyy}" Width="85"/>
                <DataGridTextColumn Header="Destino" Binding="{Binding CiudadDestino}" Width="90"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Formulario}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Titulo}" Style="{StaticResource Subtitulo}"/>

                    <TextBlock Text="CLIENTE" Style="{StaticResource Etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Clientes}"
                              DisplayMemberPath="Empresa"
                              SelectedValuePath="ClienteID"
                              SelectedValue="{Binding Editado.ClienteID}"/>

                    <TextBlock Text="EMPLEADO" Style="{StaticResource Etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Empleados}"
                              DisplayMemberPath="NombreCompleto"
                              SelectedValuePath="EmpleadoID"
                              SelectedValue="{Binding Editado.EmpleadoID}"/>

                    <TextBlock Text="TRANSPORTISTA" Style="{StaticResource Etiqueta}"/>
                    <ComboBox ItemsSource="{Binding Transportistas}"
                              DisplayMemberPath="CompaniaNombre"
                              SelectedValuePath="TransportistaID"
                              SelectedValue="{Binding Editado.TransportistaID}"/>

                    <TextBlock Text="FECHA DEL PEDIDO" Style="{StaticResource Etiqueta}"/>
                    <DatePicker SelectedDate="{Binding Editado.FechaPedido}"/>

                    <TextBlock Text="FECHA REQUERIDA" Style="{StaticResource Etiqueta}"/>
                    <DatePicker SelectedDate="{Binding Editado.FechaRequerida}"/>

                    <TextBlock Text="FECHA DE ENVIO" Style="{StaticResource Etiqueta}"/>
                    <DatePicker SelectedDate="{Binding Editado.FechaEnvio}"/>

                    <TextBlock Text="DESTINATARIO" Style="{StaticResource Etiqueta}"/>
                    <TextBox Text="{Binding Editado.Destinatario}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="CIUDAD DESTINO" Style="{StaticResource Etiqueta}"/>
                            <TextBox Text="{Binding Editado.CiudadDestino}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="PAIS DESTINO" Style="{StaticResource Etiqueta}"/>
                            <TextBox Text="{Binding Editado.PaisDestino}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Guardar" Command="{Binding GuardarCommand}" Margin="0,0,8,0"/>
                        <Button Content="Nuevo" Command="{Binding NuevoCommand}"
                                Style="{StaticResource BotonSecundario}" Margin="0,0,8,0"/>
                        <Button Content="Eliminar" Command="{Binding EliminarCommand}"
                                Style="{StaticResource BotonPeligro}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Mensaje}"
                   Style="{StaticResource Mensaje}" Margin="0,16,0,0"/>
    </Grid>
</UserControl>
