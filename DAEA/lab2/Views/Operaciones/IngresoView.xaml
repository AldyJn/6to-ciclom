<UserControl x:Class="lab2.Views.Operaciones.IngresoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Registro de Ingreso" Style="{StaticResource Titulo}"/>

        <Grid Grid.Row="1" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="320"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*" MaxWidth="320"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Tipo de documento" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="cboTipoDocumento"/>

                <TextBlock Text="Número de documento" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtNumeroDocumento"/>

                <TextBlock Text="Placa" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="cboPlaca" IsEditable="True"/>

                <TextBlock Text="Turno" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="cboTurno"/>

                <TextBlock Text="Nombre del conductor" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="cboConductor" IsEditable="True"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Nombre del cliente" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtCliente"/>

                <TextBlock Text="Producto" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="cboProducto"/>

                <TextBlock Text="Transporte" Style="{StaticResource Etiqueta}"/>
                <ComboBox x:Name="cboTransporte"/>

                <TextBlock Text="Fecha" Style="{StaticResource Etiqueta}"/>
                <DatePicker x:Name="dpFecha"/>

                <TextBlock Text="Hora (HH:mm)" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtHora"/>

                <TextBlock Text="Peso de ingreso (kg)" Style="{StaticResource Etiqueta}"/>
                <TextBox x:Name="txtPeso"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Guardar" Click="Guardar_Click" Margin="0,0,10,0"/>
            <Button Content="Limpiar" Style="{StaticResource BotonSecundario}" Click="Limpiar_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
