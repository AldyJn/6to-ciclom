<UserControl x:Class="lab2.Views.Mantenimientos.ConductoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Conductores" FontSize="20" FontWeight="SemiBold"/>
            <Button Content="Nuevo" HorizontalAlignment="Right" Click="Nuevo_Click"/>
        </Grid>

        <DataGrid Grid.Row="1" x:Name="grid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre Conductor" Binding="{Binding Nombre}" Width="2*"/>
                <DataGridTextColumn Header="Licencia" Binding="{Binding Licencia}" Width="*"/>
                <DataGridTextColumn Header="Transporte" Binding="{Binding Transporte}" Width="2*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
