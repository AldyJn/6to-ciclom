<UserControl x:Class="lab2.Views.Reportes.ReporteCargasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reporte de Cargas" Style="{StaticResource Titulo}"/>

        <DataGrid Grid.Row="1" x:Name="grid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="*"/>
                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="*"/>
                <DataGridTextColumn Header="Conductor" Binding="{Binding Conductor}" Width="1.5*"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/>
                <DataGridTextColumn Header="Peso Ingreso" Binding="{Binding PesoIngreso, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Peso Salida" Binding="{Binding PesoSalida, StringFormat=N2}" Width="*"/>
                <DataGridTextColumn Header="Peso Neto" Binding="{Binding PesoNeto, StringFormat=N2}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
