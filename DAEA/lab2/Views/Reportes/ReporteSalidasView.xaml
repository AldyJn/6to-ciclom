<UserControl x:Class="lab2.Views.Reportes.ReporteSalidasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Reporte de Salidas" Style="{StaticResource Titulo}"/>

        <DataGrid Grid.Row="1" x:Name="grid">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="*"/>
                <DataGridTextColumn Header="Documento" Binding="{Binding NumeroDocumento}" Width="*"/>
                <DataGridTextColumn Header="Placa" Binding="{Binding Placa}" Width="*"/>
                <DataGridTextColumn Header="Turno" Binding="{Binding Turno}" Width="*"/>
                <DataGridTextColumn Header="Conductor" Binding="{Binding Conductor}" Width="1.5*"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="*"/>
                <DataGridTextColumn Header="Peso" Binding="{Binding Peso, StringFormat=N2}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
