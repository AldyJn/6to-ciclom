<Window x:Class="lab2.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lab 2" Height="640" Width="1080"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Linea}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,24,20,4">
                    <TextBlock Text="Lab 2" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="admin" Foreground="{StaticResource Suave}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Content="Cerrar sesión" Style="{StaticResource BotonTexto}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,16" Click="CerrarSesion_Click"/>

                <StackPanel>
                    <TextBlock Text="OPERACIONES" Style="{StaticResource Seccion}"/>
                    <RadioButton x:Name="navIngresos" Style="{StaticResource NavItem}" GroupName="nav" Content="Ingresos" Click="Ingresos_Click"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Salida" Click="Salidas_Click"/>

                    <TextBlock Text="MANTENIMIENTOS" Style="{StaticResource Seccion}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Conductores" Click="Conductores_Click"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Transportistas" Click="Transportistas_Click"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Camiones" Click="Camiones_Click"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Productos" Click="Productos_Click"/>

                    <TextBlock Text="REPORTES" Style="{StaticResource Seccion}"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Cargas" Click="ReporteCargas_Click"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Ingresos" Click="ReporteIngresos_Click"/>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Salidas" Click="ReporteSalidas_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" x:Name="host" Margin="40,30"/>
    </Grid>
</Window>
