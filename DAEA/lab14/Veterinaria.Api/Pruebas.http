###
POST {{host}}/api/auth/registro
Content-Type: application/json

{ "correo": "recepcion@veterinaria.pe", "clave": "Clave123!" }

###
# @name loginRecepcion
POST {{host}}/api/auth/login
Content-Type: application/json

{ "correo": "recepcion@veterinaria.pe", "clave": "Clave123!" }

###
# @name loginVeterinario
POST {{host}}/api/auth/login
Content-Type: application/json

{ "correo": "veterinario@veterinaria.pe", "clave": "Clave123!" }

###
# @name loginAsistente
POST {{host}}/api/auth/login
Content-Type: application/json

{ "correo": "asistente@veterinaria.pe", "clave": "Clave123!" }

###
POST {{host}}/api/auth/login
Content-Type: application/json

{ "correo": "recepcion@veterinaria.pe", "clave": "ClaveMala1" }

###
@tokenR = {{loginRecepcion.response.body.$.token}}
@tokenV = {{loginVeterinario.response.body.$.token}}
@tokenA = {{loginAsistente.response.body.$.token}}

###
GET {{host}}/api/auth/perfil
Authorization: Bearer {{tokenV}}

###
GET {{host}}/api/auth/perfil

###
GET {{host}}/api/propietarios
Authorization: Bearer {{tokenA}}

###
GET {{host}}/api/propietarios/1/mascotas
Authorization: Bearer {{tokenR}}

###
POST {{host}}/api/propietarios
Authorization: Bearer {{tokenR}}
Content-Type: application/json

