<UserControl x:Class="Neptuno.App.Vistas.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,16,0">
            <TextBlock Text="Datos del producto" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtNombre" MaxLength="60"/>

            <TextBlock Text="Categoria" Style="{StaticResource Etiqueta}"/>
            <ComboBox x:Name="cboCategoria" DisplayMemberPath="NombreCategoria"
                      SelectedValuePath="CategoriaID"/>

            <TextBlock Text="Proveedor" Style="{StaticResource Etiqueta}"/>
            <ComboBox x:Name="cboProveedor" DisplayMemberPath="CompaniaNombre"
                      SelectedValuePath="ProveedorID"/>

            <TextBlock Text="Cantidad por unidad" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtCantidadPorUnidad" MaxLength="30"/>

            <TextBlock Text="Precio unitario" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtPrecio" Text="0"/>

            <TextBlock Text="Unidades en existencia" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtExistencia" Text="0"/>

            <CheckBox x:Name="chkDescontinuado" Content="Descontinuado" Margin="0,4,0,0"/>

            <TextBlock x:Name="lblEstado" Foreground="#666" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Nuevo" Click="Nuevo_Click"/>
            <Button Content="Guardar" Click="Guardar_Click"/>
            <Button Content="Eliminar" Click="Eliminar_Click"/>
            <Button Content="Refrescar" Click="Refrescar_Click"/>
        </StackPanel>

        <DataGrid x:Name="grilla" Grid.Column="1" Grid.Row="1"
                  SelectionChanged="Grilla_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ProductoID}" Width="55"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding NombreProducto}" Width="*"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="130"/>
                <DataGridTextColumn Header="Proveedor" Binding="{Binding Proveedor}" Width="160"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Stock" Binding="{Binding UnidadesEnExistencia}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
