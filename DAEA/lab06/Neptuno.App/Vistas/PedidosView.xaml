<UserControl x:Class="Neptuno.App.Vistas.PedidosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,16,0">
            <TextBlock Text="Datos del pedido" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Text="Cliente" Style="{StaticResource Etiqueta}"/>
            <ComboBox x:Name="cboCliente" DisplayMemberPath="Empresa" SelectedValuePath="ClienteID"/>

            <TextBlock Text="Empleado" Style="{StaticResource Etiqueta}"/>
            <ComboBox x:Name="cboEmpleado" DisplayMemberPath="Empleado" SelectedValuePath="EmpleadoID"/>

            <TextBlock Text="Transportista" Style="{StaticResource Etiqueta}"/>
            <ComboBox x:Name="cboTransportista" DisplayMemberPath="CompaniaNombre"
                      SelectedValuePath="TransportistaID"/>

            <TextBlock Text="Fecha del pedido" Style="{StaticResource Etiqueta}"/>
            <DatePicker x:Name="dpFechaPedido"/>

            <TextBlock Text="Fecha requerida" Style="{StaticResource Etiqueta}"/>
            <DatePicker x:Name="dpFechaRequerida"/>

            <TextBlock Text="Fecha de envio" Style="{StaticResource Etiqueta}"/>
            <DatePicker x:Name="dpFechaEnvio"/>

            <TextBlock Text="Destinatario" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtDestinatario" MaxLength="60"/>

            <TextBlock Text="Ciudad destino" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtCiudadDestino" MaxLength="30"/>

            <TextBlock x:Name="lblEstado" Foreground="#666" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Nuevo" Click="Nuevo_Click"/>
            <Button Content="Guardar" Click="Guardar_Click"/>
            <Button Content="Eliminar" Click="Eliminar_Click"/>
            <Button Content="Refrescar" Click="Refrescar_Click"/>
        </StackPanel>

        <DataGrid x:Name="grilla" Grid.Column="1" Grid.Row="1"
                  SelectionChanged="Grilla_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding PedidoID}" Width="55"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                <DataGridTextColumn Header="Empleado" Binding="{Binding Empleado}" Width="150"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat=d}" Width="90"/>
                <DataGridTextColumn Header="Envio" Binding="{Binding FechaEnvio, StringFormat=d}" Width="90"/>
                <DataGridTextColumn Header="Destinatario" Binding="{Binding Destinatario}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
