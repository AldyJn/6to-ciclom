<UserControl x:Class="Neptuno.App.Vistas.CategoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.RowSpan="2" Margin="0,0,16,0">
            <TextBlock Text="Datos de la categoria" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtNombre" MaxLength="30"/>

            <TextBlock Text="Descripcion" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtDescripcion" MaxLength="200" Height="80"
                     TextWrapping="Wrap" AcceptsReturn="True"/>

            <TextBlock x:Name="lblEstado" Foreground="#666" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Nuevo" Click="Nuevo_Click"/>
            <Button Content="Guardar" Click="Guardar_Click"/>
            <Button Content="Eliminar" Click="Eliminar_Click"/>
            <Button Content="Refrescar" Click="Refrescar_Click"/>
        </StackPanel>

        <DataGrid x:Name="grilla" Grid.Column="1" Grid.Row="1"
                  SelectionChanged="Grilla_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding CategoriaID}" Width="60"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding NombreCategoria}" Width="200"/>
                <DataGridTextColumn Header="Descripcion" Binding="{Binding Descripcion}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
