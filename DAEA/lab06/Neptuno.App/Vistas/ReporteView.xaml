<UserControl x:Class="Neptuno.App.Vistas.ReporteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#F7F9FC" BorderBrush="{StaticResource Borde}"
                BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="dpDesde" Width="130" Margin="0,0,12,0"/>
                <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <DatePicker x:Name="dpHasta" Width="130" Margin="0,0,12,0"/>
                <Button Content="Generar reporte" Click="Generar_Click"/>
            </StackPanel>
        </Border>

        <DataGrid x:Name="grilla" Grid.Row="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Pedido" Binding="{Binding PedidoID}" Width="70"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding FechaPedido, StringFormat=d}" Width="90"/>
                <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="200"/>
                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="130"/>
                <DataGridTextColumn Header="Precio" Binding="{Binding PrecioUnidad, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=N2}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="lblEstado" Grid.Row="2" Margin="0,10,0,0" Foreground="#666"/>
    </Grid>
</UserControl>
