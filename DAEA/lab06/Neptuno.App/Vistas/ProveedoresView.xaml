<UserControl x:Class="Neptuno.App.Vistas.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Grid.RowSpan="3" Margin="0,0,16,0">
            <TextBlock Text="Datos del proveedor" FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Text="Compania" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtCompania" MaxLength="60"/>

            <TextBlock Text="Nombre de contacto" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtContacto" MaxLength="40"/>

            <TextBlock Text="Cargo del contacto" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtCargo" MaxLength="40"/>

            <TextBlock Text="Direccion" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtDireccion" MaxLength="80"/>

            <TextBlock Text="Ciudad" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtCiudad" MaxLength="30"/>

            <TextBlock Text="Pais" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtPais" MaxLength="30"/>

            <TextBlock Text="Telefono" Style="{StaticResource Etiqueta}"/>
            <TextBox x:Name="txtTelefono" MaxLength="24"/>

            <TextBlock x:Name="lblEstado" Foreground="#666" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Column="1" Background="#F7F9FC" BorderBrush="{StaticResource Borde}"
                BorderThickness="1" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Contacto" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="txtFiltroContacto" Width="150" Margin="0,0,12,0"/>
                <TextBlock Text="Ciudad" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox x:Name="txtFiltroCiudad" Width="150" Margin="0,0,12,0"/>
                <Button Content="Buscar" Click="Buscar_Click"/>
                <Button Content="Limpiar filtros" Click="LimpiarFiltros_Click"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Nuevo" Click="Nuevo_Click"/>
            <Button Content="Guardar" Click="Guardar_Click"/>
            <Button Content="Eliminar" Click="Eliminar_Click"/>
        </StackPanel>

        <DataGrid x:Name="grilla" Grid.Column="1" Grid.Row="2"
                  SelectionChanged="Grilla_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ProveedorID}" Width="55"/>
                <DataGridTextColumn Header="Compania" Binding="{Binding CompaniaNombre}" Width="*"/>
                <DataGridTextColumn Header="Contacto" Binding="{Binding NombreContacto}" Width="150"/>
                <DataGridTextColumn Header="Ciudad" Binding="{Binding Ciudad}" Width="120"/>
                <DataGridTextColumn Header="Pais" Binding="{Binding Pais}" Width="100"/>
                <DataGridTextColumn Header="Telefono" Binding="{Binding Telefono}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
