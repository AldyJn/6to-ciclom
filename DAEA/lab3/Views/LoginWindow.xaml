<Window x:Class="lab3.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reservas de Aulas" Height="420" Width="380"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="40" VerticalAlignment="Center">
        <TextBlock Text="Reservas de Aulas" Style="{StaticResource Titulo}"/>

        <TextBlock Text="USUARIO" Style="{StaticResource Etiqueta}"/>
        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Text="CONTRASEÑA" Style="{StaticResource Etiqueta}"/>
        <PasswordBox x:Name="clave" PasswordChanged="Clave_PasswordChanged"/>

        <Button Content="Ingresar" Command="{Binding IngresarCommand}" IsDefault="True" Margin="0,6,0,0"/>

        <TextBlock Text="{Binding Mensaje}" Foreground="#C0392B" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
