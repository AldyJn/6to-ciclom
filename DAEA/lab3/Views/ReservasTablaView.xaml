<UserControl x:Class="lab3.Views.ReservasTablaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Reservas (DataTable)" Style="{StaticResource Titulo}"/>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Reservas}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding ReservaId}" Width="80"/>
                <DataGridTextColumn Header="Aula" Binding="{Binding Aula}" Width="180"/>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Usuario}" Width="180"/>
                <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Hora" Binding="{Binding Hora, StringFormat={}{0:hh\\:mm}}" Width="80"/>
                <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
