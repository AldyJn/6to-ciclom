<UserControl x:Class="lab3.Views.AulasObjetosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Aulas (Objetos)" Style="{StaticResource Titulo}"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox Width="280" Margin="0,0,10,0"
                         Text="{Binding Filtro, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="Buscar" Command="{Binding BuscarCommand}" IsDefault="True" Height="30" VerticalAlignment="Top"/>
            </StackPanel>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Aulas}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding AulaId}" Width="90"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Capacidad" Binding="{Binding Capacidad}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
