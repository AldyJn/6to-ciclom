@model EventoListaVM
@{
    ViewData["Title"] = "Eliminar evento";
}

<h1>Eliminar evento</h1>

<div class="tarjeta formulario">
    <p>¿Seguro que deseas eliminar este evento? El registro se desactivará y dejará de mostrarse.</p>
    <dl class="row detalle">
        <dt class="col-sm-4">Título</dt>
        <dd class="col-sm-8">@Model.Titulo</dd>
        <dt class="col-sm-4">Fecha</dt>
        <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>
        <dt class="col-sm-4">Lugar</dt>
        <dd class="col-sm-8">@Model.Lugar</dd>
        <dt class="col-sm-4">Inscritos</dt>
        <dd class="col-sm-8">@Model.Inscritos de @Model.Aforo</dd>
    </dl>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button type="submit" class="btn-peligro">Eliminar</button>
        <a class="btn-sec" asp-action="Index">Cancelar</a>
    </form>
</div>
